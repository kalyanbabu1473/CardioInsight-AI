# Node / frontend (kept minimal; see frontend/.gitignore)
node_modules/
dist/
npm-debug.log*

# ML artefacts — large serialized research models + train-only outputs are NOT
# committed. The deployment artifact (assessment model + feature list) IS needed
# at runtime by backend/CI/Docker, so it is tracked via explicit negation. The
# ~21.8 MB clinical model is committed as a normal binary, not Git LFS, because
# deployment hosts do not reliably smudge LFS during checkout.
Models/*.pkl
!Models/CardioAI_Assessment_Model.pkl
!Models/CardioAI_Assessment_Features.pkl
Models/*.csv
Models/*.png
Models/archive/
Outputs/
!Models/CardioAI_Clinical_Model.pkl
!Models/CardioAI_Clinical_Calibrator.pkl
!Models/CardioAI_Clinical_Features.pkl
!Models/CardioAI_Clinical_Metrics.json
!Models/CardioAI_Clinical_Preprocessing.json
!Models/CardioAI_Clinical_Manifest.json
!Models/CardioAI_Clinical_Feature_Importance.csv

# Deployment full-config backups (never commit secrets)
docker-compose.override.yml
*.networkconfig

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

