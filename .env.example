# --- Frontend / Vite ------------------------------------------------
# Base URL used by the production frontend to reach the backend API.
# In dev, Vite serves /api via its proxy (see frontend/vite.config.ts), so the
# default is "/api". Point this at the deployed backend when serving the built
# bundle from a static host via CORS.
VITE_API_URL=/api

# --- Dev ports -----------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000