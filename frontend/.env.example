# API base URL for the CardioInsight backend.
#
# Local development defaults to the relative `/api` path, which the Vite dev
# server proxies to http://127.0.0.1:8000 (see vite.config.ts). Set this to
# point the frontend at a specific backend without touching code.
#
# Example (local FastAPI backend):
VITE_API_BASE_URL=http://127.0.0.1:8000
