{
  "schema_version": "3.0.0",
  "training_cohort": "NHANES 2017-March 2020 adults 18-80 with complete observed model features; no continuous imputation; unknown categorical codes excluded",
  "model": "CardioAI_Clinical_Model.pkl",
  "target": "Composite_CVD",
  "feature_count": 18,
  "feature_order": [
    "RIDAGEYR",
    "RIAGENDR",
    "BMXHT",
    "BMXWT",
    "BMXWAIST",
    "BMXBMI",
    "BPXOSY1",
    "BPXODI1",
    "BPQ020",
    "LBXGH",
    "LBXGLU",
    "LBXTC",
    "LBDLDL",
    "LBDHDD",
    "LBXTR",
    "LBXIN",
    "SMQ020",
    "SMQ040"
  ],
  "calibration": "isotonic",
  "risk_thresholds": {
    "low": 0.05,
    "high": 0.2
  },
  "categories": {
    "demographics": "Demographics",
    "bodyComposition": "Body Composition",
    "bloodPressure": "Blood Pressure & History",
    "metabolic": "Metabolic Panel",
    "lipids": "Lipid Panel",
    "lifestyle": "Lifestyle"
  },
  "subgroup_labels": {},
  "features": [
    {
      "name": "RIDAGEYR",
      "label": "Age",
      "unit": "years",
      "domain": "Demographics",
      "category": "demographics",
      "notes": "Age in years (right-censored at 80). The deployed model is trained and validated on adults aged 18-80; pediatric assessments are not supported.",
      "required": true,
      "field": "demographics.age",
      "type": "continuous",
      "min": 18,
      "max": 80,
      "mean": 49.13
    },
    {
      "name": "RIAGENDR",
      "label": "Sex",
      "unit": "",
      "domain": "Demographics",
      "category": "demographics",
      "notes": "Biological sex (Male=1, Female=2).",
      "required": true,
      "field": "demographics.sex",
      "type": "categorical",
      "options": [
        "Male",
        "Female"
      ],
      "encode": {
        "Male": 1,
        "Female": 2
      }
    },
    {
      "name": "BMXHT",
      "label": "Height",
      "unit": "cm",
      "domain": "Body Measurements",
      "category": "bodyComposition",
      "notes": "Standing height.",
      "required": true,
      "field": "bodyComposition.heightCm",
      "type": "continuous",
      "min": 131.1,
      "max": 198.7,
      "mean": 167.23
    },
    {
      "name": "BMXWT",
      "label": "Weight",
      "unit": "kg",
      "domain": "Body Measurements",
      "category": "bodyComposition",
      "notes": "Measured body weight.",
      "required": true,
      "field": "bodyComposition.weightKg",
      "type": "continuous",
      "min": 39.6,
      "max": 204.6,
      "mean": 83.29
    },
    {
      "name": "BMXWAIST",
      "label": "Waist circumference",
      "unit": "cm",
      "domain": "Body Measurements",
      "category": "bodyComposition",
      "notes": "Measured waist circumference.",
      "required": true,
      "field": "bodyComposition.waistCm",
      "display": {
        "unit": "in",
        "factor": 2.54
      },
      "type": "continuous",
      "min": 61.1,
      "max": 178.0,
      "mean": 100.28
    },
    {
      "name": "BMXBMI",
      "label": "Body mass index",
      "unit": "kg/m2",
      "domain": "Body Measurements",
      "category": "bodyComposition",
      "notes": "Derived from measured height and weight (kg/m^2), rounded to four decimals. Training and live inference use the same derivation; the imputed NHANES BMXBMI column is not used.",
      "required": true,
      "field": "bodyComposition.bmi",
      "derived": true,
      "type": "continuous",
      "min": 15.4317,
      "max": 67.0369,
      "mean": 29.7088
    },
    {
      "name": "BPXOSY1",
      "label": "Systolic blood pressure",
      "unit": "mmHg",
      "domain": "Blood Pressure",
      "category": "bloodPressure",
      "notes": "First systolic blood pressure reading.",
      "required": true,
      "field": "bloodPressure.systolicBP",
      "type": "continuous",
      "min": 66.0,
      "max": 217.0,
      "mean": 123.61
    },
    {
      "name": "BPXODI1",
      "label": "Diastolic blood pressure",
      "unit": "mmHg",
      "domain": "Blood Pressure",
      "category": "bloodPressure",
      "notes": "First diastolic blood pressure reading.",
      "required": true,
      "field": "bloodPressure.diastolicBP",
      "type": "continuous",
      "min": 36.0,
      "max": 131.0,
      "mean": 74.71
    },
    {
      "name": "BPQ020",
      "label": "High blood pressure diagnosis",
      "unit": "",
      "domain": "Blood Pressure",
      "category": "bloodPressure",
      "notes": "Ever told by a doctor you had high blood pressure (Yes=1, No=2). Refused/don't-know codes are excluded.",
      "required": true,
      "field": "bloodPressure.hypertensionDiagnosis",
      "type": "categorical",
      "options": [
        "Yes",
        "No"
      ],
      "encode": {
        "Yes": 1,
        "No": 2
      }
    },
    {
      "name": "LBXGH",
      "label": "HbA1c / glycated hemoglobin",
      "unit": "%",
      "domain": "Laboratory",
      "category": "metabolic",
      "notes": "Glycohemoglobin from whole blood.",
      "required": true,
      "field": "metabolic.hba1c",
      "type": "continuous",
      "min": 2.8,
      "max": 15.2,
      "mean": 5.83
    },
    {
      "name": "LBXGLU",
      "label": "Fasting glucose",
      "unit": "mg/dL",
      "domain": "Laboratory",
      "category": "metabolic",
      "notes": "Fasting serum glucose.",
      "required": true,
      "field": "metabolic.fastingGlucose",
      "type": "continuous",
      "min": 47.0,
      "max": 451.0,
      "mean": 112.19
    },
    {
      "name": "LBXTC",
      "label": "Total cholesterol",
      "unit": "mg/dL",
      "domain": "Laboratory",
      "category": "lipids",
      "notes": "Total serum cholesterol.",
      "required": true,
      "field": "lipids.totalCholesterol",
      "type": "continuous",
      "min": 76,
      "max": 428,
      "mean": 182.64
    },
    {
      "name": "LBDLDL",
      "label": "LDL cholesterol",
      "unit": "mg/dL",
      "domain": "Laboratory",
      "category": "lipids",
      "notes": "Direct low-density lipoprotein cholesterol.",
      "required": true,
      "field": "lipids.ldlCholesterol",
      "type": "continuous",
      "min": 7,
      "max": 357,
      "mean": 108.23
    },
    {
      "name": "LBDHDD",
      "label": "HDL cholesterol",
      "unit": "mg/dL",
      "domain": "Laboratory",
      "category": "lipids",
      "notes": "Direct high-density lipoprotein cholesterol.",
      "required": true,
      "field": "lipids.hdlCholesterol",
      "type": "continuous",
      "min": 11,
      "max": 187,
      "mean": 53.67
    },
    {
      "name": "LBXTR",
      "label": "Triglycerides",
      "unit": "mg/dL",
      "domain": "Laboratory",
      "category": "lipids",
      "notes": "Serum triglycerides.",
      "required": true,
      "field": "lipids.triglycerides",
      "type": "continuous",
      "min": 10.0,
      "max": 399.0,
      "mean": 103.72
    },
    {
      "name": "LBXIN",
      "label": "Fasting insulin",
      "unit": "uU/mL",
      "domain": "Laboratory",
      "category": "metabolic",
      "notes": "Fasting serum insulin.",
      "required": true,
      "field": "metabolic.insulin",
      "type": "continuous",
      "min": 0.71,
      "max": 512.5,
      "mean": 14.66
    },
    {
      "name": "SMQ020",
      "label": "Ever smoked 100 cigarettes",
      "unit": "",
      "domain": "Lifestyle",
      "category": "lifestyle",
      "notes": "Ever smoked at least 100 cigarettes in your lifetime (Yes=1, No=2). Refused/don't-know codes are excluded.",
      "required": true,
      "field": "lifestyle.everSmoked100",
      "type": "categorical",
      "options": [
        "Yes",
        "No"
      ],
      "encode": {
        "Yes": 1,
        "No": 2
      }
    },
    {
      "name": "SMQ040",
      "label": "Current cigarette smoking",
      "unit": "",
      "domain": "Lifestyle",
      "category": "lifestyle",
      "notes": "Currently smoke cigarettes (Every day=1, Some days=2, Not at all=3). For never-smokers (SMQ020=No), NHANES skips this question and the model uses the structural skip value 3; live input must still say 'Not at all'.",
      "required": true,
      "field": "lifestyle.currentSmoking",
      "type": "categorical",
      "options": [
        "Every day",
        "Some days",
        "Not at all"
      ],
      "encode": {
        "Every day": 1,
        "Some days": 2,
        "Not at all": 3
      }
    }
  ]
}