# --- Runtime -------------------------------------------------------
# development | production (drives logging verbosity only).
ENVIRONMENT=development

# --- Hosting (used by `uvicorn` run instructions in DEPLOYMENT.md) ---
HOST=127.0.0.1
PORT=8000
RELOAD=false

# No database configuration is required. Assessments are kept in process
# memory; Supabase/PostgreSQL/SQLAlchemy are not used. Do NOT add a
# DATABASE_URL or database credentials for this application.

# --- ML model artifacts ------------------------------------------------
# Defaults resolve relative to the repository root (tracked artifacts):
#   - Models/CardioAI_Clinical_Model.pkl       (normal binary, ~21.8 MB, 18 features)
#   - Models/CardioAI_Clinical_Calibrator.pkl  (isotonic calibration)
#   - Models/CardioAI_Clinical_Features.pkl
#   - Models/CardioAI_Clinical_Preprocessing.json
#   - Models/CardioAI_Clinical_Metrics.json
#   - Models/CardioAI_Clinical_Manifest.json   (SHA-256 verification)
#   - feature_contract.json
# Relative overrides resolve from the repository root, never the process CWD.
# Use these only for absolute volume mounts or non-default deployment layouts.
# Every override must keep the canonical clinical artifact filename; stale
# legacy names (for example Random_Forest_Model.pkl) fail closed.
# On Render, leave all ML_* variables unset and use the repository defaults.
# ML_MODEL_PATH=Models/CardioAI_Clinical_Model.pkl
# ML_CALIBRATOR_PATH=Models/CardioAI_Clinical_Calibrator.pkl
# ML_FEATURES_PATH=Models/CardioAI_Clinical_Features.pkl
# ML_CONTRACT_PATH=feature_contract.json
# ML_PREPROCESSING_PATH=Models/CardioAI_Clinical_Preprocessing.json
# ML_METRICS_PATH=Models/CardioAI_Clinical_Metrics.json
# ML_MANIFEST_PATH=Models/CardioAI_Clinical_Manifest.json

# --- CORS --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API directly.
# Leave unset for localhost defaults during development.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
