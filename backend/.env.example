# --- Runtime -------------------------------------------------------
# development | production (drives logging verbosity only).
ENVIRONMENT=development

# --- Hosting (used by `uvicorn` run instructions in DEPLOYMENT.md) ---
HOST=127.0.0.1
PORT=8000
RELOAD=false

# --- Database --------------------------------------------------------
# PostgreSQL (SQLAlchemy + psycopg driver). Required — the app reads this from
# the environment; there is no SQLite fallback when an empty value is set.
# Example:
#   DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/cardioinsight
# Never commit real credentials; copy this file to .env locally.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/cardioinsight

# --- ML model artifacts ------------------------------------------------
# Defaults resolve relative to the repository root (tracked artifacts):
#   - Models/Random_Forest/Random_Forest_Model.pkl  (Git LFS, ~83 MB, 44 features)
#   - Models/CardioAI_Assessment_Features.pkl
#   - feature_contract.json
# Point at absolute paths or volume mounts only when overriding the defaults.
# ML_MODEL_PATH=Models/Random_Forest/Random_Forest_Model.pkl
# ML_FEATURES_PATH=Models/CardioAI_Assessment_Features.pkl

# --- CORS --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API directly.
# Leave unset for localhost defaults during development.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com